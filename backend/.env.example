# Try Find Me! — OSINT Backend Environment Configuration
# Copy this file to .env and adjust values as needed.
# Never commit .env to version control.

APP_ENV=development
LOG_LEVEL=INFO
APP_NAME="Try Find Me! — OSINT"

# Server secret for HMAC signing of verification tokens.
# MUST be set in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In development, a per-process random value is generated if omitted (tokens won't survive restarts).
SERVER_SECRET=

# CORS origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# API base URL
API_BASE_URL=http://127.0.0.1:8000

# Rate limits (requests per client, per minute)
RATE_LIMIT_CHALLENGE=10
RATE_LIMIT_VERIFY=10
RATE_LIMIT_ASSESSMENT=3

# Timeouts (seconds)
MODULE_TIMEOUT_SECONDS=10
ASSESSMENT_TIMEOUT_SECONDS=30

# Token TTLs (seconds)
CHALLENGE_TTL_SECONDS=900
PROOF_TTL_SECONDS=1800

# Max request body size (bytes)
MAX_REQUEST_BODY_BYTES=4096
